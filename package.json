{
  "name": "studio137",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio 137 Phrase-to-Plate Generator — deterministic semantic glyph compiler and production-art renderer",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden": "tsx apps/cli/src/index.ts golden --out artifacts",
    "compile": "tsx apps/cli/src/index.ts compile",
    "geometry:hash": "tsx scripts/generate-geometry-integrity.ts",
    "golden:hash": "tsx scripts/generate-golden-hashes.ts",
    "verify:ring": "tsx scripts/verify-ring-page.ts",
    "s137": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@studio137/artifact-security": "workspace:*",
    "@studio137/corruption-engine": "workspace:*",
    "@studio137/envelope-engine": "workspace:*",
    "@studio137/glyph-engine": "workspace:*",
    "@studio137/glyph-registry": "workspace:*",
    "@studio137/layout-engine": "workspace:*",
    "@studio137/plate-compiler": "workspace:*",
    "@studio137/plate-core": "workspace:*",
    "@studio137/private-manifest": "workspace:*",
    "@studio137/render-raster": "workspace:*",
    "@studio137/render-svg": "workspace:*",
    "@studio137/ring": "workspace:*",
    "@studio137/substrate-engine": "workspace:*",
    "@studio137/walk-engine": "workspace:*",
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2",
    "playwright": "1.56.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
